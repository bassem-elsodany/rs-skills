[package]
name = "ports-adapters-example"
version = "0.1.0"
edition = "2024"
rust-version = "1.85"
publish = false

[dependencies]
thiserror = "2"
tokio = { version = "1", features = ["rt", "macros", "sync", "time"] }

[lints.rust]
unsafe_code = "forbid"

[lints.clippy]
all = { level = "warn", priority = -1 }
pedantic = { level = "warn", priority = -1 }
module_name_repetitions = "allow"
